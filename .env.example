APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# User-facing dates (Blade uses config/dates.php; defaults shown)
# DATE_DISPLAY_FORMAT=m-d-Y
# DATE_DISPLAY_DATETIME_FORMAT="m-d-Y g:i A"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This application uses MySQL exclusively.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_db
DB_USERNAME=restaurant_user
DB_PASSWORD=restaurant_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — required for email verification & password-reset links (Phase 4).
# Set MAIL_MAILER=smtp and fill in the credentials from your provider
# (Mailgun, Postmark, Amazon SES, Gmail SMTP, etc.). Use MAIL_MAILER=log for
# local dev to write messages to storage/logs/laravel.log instead of sending.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Trial system (Phase 4)
TRIAL_DAYS=30
TRIAL_EXPIRING_SOON_DAYS=3
SALES_TEAM_EMAIL=sales@yourdomain.com

# Stripe / Laravel Cashier (Phase 4 — Payments)
# Fill these in from the Stripe dashboard (use test keys in dev).
# Developers → API keys: publishable key (pk_...) and secret key (sk_...)
STRIPE_KEY=
STRIPE_SECRET=
# Developers → Webhooks → your endpoint's signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
# The recurring Price you create in Stripe (Products → your plan → Pricing): price_...
STRIPE_PRICE_ID=
SUBSCRIPTION_PLAN_NAME="Pro"
# Monthly amount in cents — used for local MRR reporting (keep in sync with the Stripe price).
SUBSCRIPTION_MONTHLY_AMOUNT=9900

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
